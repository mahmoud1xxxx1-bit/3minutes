rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'gameName',
          'avatarId',
          'level',
          'xp',
          'rankPoints',
          'stars',
          'wins',
          'losses',
          'gamesPlayed',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.rankPoints == 0
        && request.resource.data.stars == 0
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.gamesPlayed == 0;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'gameName',
          'avatarId',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // Spark-era queue. Blaze will move opponent claim and match creation to
    // Cloud Functions while keeping the same MatchBackend contract in Flutter.
    match /matchmaking/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'gameName',
          'avatarId',
          'status',
          'matchId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.matchId == null;

      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'matched'
        && request.resource.data.matchId is string
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.gameName == resource.data.gameName
        && request.resource.data.avatarId == resource.data.avatarId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'matchId',
          'updatedAt'
        ]);

      allow delete: if isOwner(uid);
    }

    match /matches/{matchId} {
      function participant() {
        return signedIn()
          && (request.auth.uid == resource.data.playerAId
            || request.auth.uid == resource.data.playerBId);
      }

      function validProgress(progress) {
        return progress.keys().hasOnly([
          'completedGames',
          'totalScore',
          'accuracyTotal',
          'mistakes',
          'elapsedMs',
          'completedAt'
        ])
        && progress.completedGames is int
        && progress.completedGames >= 0
        && progress.completedGames <= 8
        && progress.totalScore is int
        && progress.totalScore >= 0
        && progress.accuracyTotal is number
        && progress.accuracyTotal >= 0
        && progress.accuracyTotal <= 8
        && progress.mistakes is int
        && progress.mistakes >= 0
        && progress.elapsedMs is int
        && progress.elapsedMs >= 0
        && (progress.completedAt == null || progress.completedAt is timestamp);
      }

      function progressMovesForward(before, after) {
        return validProgress(after)
          && after.completedGames >= before.completedGames
          && after.completedGames <= before.completedGames + 1
          && after.totalScore >= before.totalScore
          && after.accuracyTotal >= before.accuracyTotal
          && after.mistakes >= before.mistakes
          && after.elapsedMs >= before.elapsedMs
          && (
            (before.completedAt != null && after.completedAt == before.completedAt)
            || (before.completedAt == null
              && ((after.completedGames < 8 && after.completedAt == null)
                || (after.completedGames == 8 && after.completedAt is timestamp)))
          );
      }

      allow read: if participant();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'playerAId',
          'playerAName',
          'playerAAvatarId',
          'playerBId',
          'playerBName',
          'playerBAvatarId',
          'seed',
          'gameCount',
          'registryVersion',
          'status',
          'readyA',
          'readyB',
          'progressA',
          'progressB',
          'countdownStartedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.playerAId != request.resource.data.playerBId
        && (request.auth.uid == request.resource.data.playerAId
          || request.auth.uid == request.resource.data.playerBId)
        && request.resource.data.status == 'waitingReady'
        && request.resource.data.readyA == false
        && request.resource.data.readyB == false
        && request.resource.data.countdownStartedAt == null
        && request.resource.data.gameCount == 8
        && validProgress(request.resource.data.progressA)
        && validProgress(request.resource.data.progressB)
        && request.resource.data.progressA.completedGames == 0
        && request.resource.data.progressB.completedGames == 0;

      // READY updates: each player may change only their own ready flag. The
      // second READY may atomically start the shared countdown.
      allow update: if participant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readyA',
          'readyB',
          'status',
          'countdownStartedAt',
          'updatedAt'
        ])
        && request.resource.data.progressA == resource.data.progressA
        && request.resource.data.progressB == resource.data.progressB
        && (
          (request.auth.uid == resource.data.playerAId
            && request.resource.data.readyB == resource.data.readyB
            && request.resource.data.readyA == true)
          ||
          (request.auth.uid == resource.data.playerBId
            && request.resource.data.readyA == resource.data.readyA
            && request.resource.data.readyB == true)
        )
        && (
          request.resource.data.status == resource.data.status
          || (
            resource.data.status == 'waitingReady'
            && request.resource.data.status == 'countdown'
            && request.resource.data.readyA == true
            && request.resource.data.readyB == true
          )
        );

      // Progress updates happen only after a mini-game ends, not for every tap.
      allow update: if participant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'progressA',
          'progressB',
          'updatedAt'
        ])
        && request.resource.data.readyA == resource.data.readyA
        && request.resource.data.readyB == resource.data.readyB
        && request.resource.data.status == resource.data.status
        && request.resource.data.countdownStartedAt == resource.data.countdownStartedAt
        && (
          (request.auth.uid == resource.data.playerAId
            && request.resource.data.progressB == resource.data.progressB
            && progressMovesForward(resource.data.progressA, request.resource.data.progressA))
          ||
          (request.auth.uid == resource.data.playerBId
            && request.resource.data.progressA == resource.data.progressA
            && progressMovesForward(resource.data.progressB, request.resource.data.progressB))
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
